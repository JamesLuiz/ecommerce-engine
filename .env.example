# Flowcheq Commerce control plane.
# Copy to .env (never commit .env) and fill in real values.
#
# This file is read by the staff dashboard, the provisioning worker and the
# provisioner. Container-specific variables live in their own templates:
#   apps/backend/.env.template              tenant Medusa backend
#   apps/storefront/.env.template           tenant storefront
#   packages/payments-gateway/.env.example  payments gateway

# --- Control plane database and queue ---
CONTROL_PLANE_DATABASE_URL=postgres://user:pass@host:5432/flowcheq_control
REDIS_URL=redis://host:6379
# 32 random bytes as 64 hex characters. Encrypts tenant secrets. Generate with
# `openssl rand -hex 32` and never change it after the first tenant exists.
SECRETS_ENCRYPTION_KEY=

# --- Internal webhooks ---
# Shared secret for POST /api/internal/releases (release workflow).
RELEASE_WEBHOOK_SECRET=
# Shared secret for the internal order endpoints. The payments gateway sends
# this when a plan payment succeeds so the order is marked paid and provisioning
# is queued. Must match ORDER_WEBHOOK_SECRET in the gateway env.
ORDER_WEBHOOK_SECRET=

# --- Tenant platform ---
# HUMAN: confirm the domain we own for customer stores.
STORE_BASE_DOMAIN=example.store
BACKEND_IMAGE=ghcr.io/flowcheq/backend
STOREFRONT_IMAGE=ghcr.io/flowcheq/storefront
# Role with CREATE ROLE / CREATE DATABASE privileges (never used by tenants).
TENANT_PG_ADMIN_URL=postgres://admin:pass@host:5432/postgres
TENANT_PG_HOST=host
TENANT_PG_PORT=5432
# Passed to every tenant backend. Optional: Medusa falls back to an in-memory
# event bus and workflow engine when empty.
TENANT_REDIS_URL=redis://host:6379

# --- Coolify ---
COOLIFY_URL=https://coolify.example.com
COOLIFY_TOKEN=
COOLIFY_PROJECT_UUID=
COOLIFY_SERVER_UUID=
COOLIFY_ENVIRONMENT_NAME=production

# --- Payments gateway ---
# The provisioner calls the gateway's /admin/* routes with this token.
GATEWAY_URL=https://gateway.example.com
PAYMENTS_GATEWAY_ADMIN_TOKEN=

# --- Tenant email (Brevo, optional) ---
# Injected into every tenant backend. Leave BREVO_API_KEY empty to boot without
# email; Admin > Messages then shows a setup notice instead of failing.
# BREVO_FROM_EMAIL must be a verified sender.
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@example.com
BREVO_FROM_NAME=Flowcheq Commerce
