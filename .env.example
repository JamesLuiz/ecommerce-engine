# Copy to .env (never commit .env) and fill in real values.
# Every value below is required at boot unless marked optional.

# --- Control plane ---
APP_URL=https://dashboard.example.com
CONTROL_PLANE_DATABASE_URL=postgres://user:pass@host:5432/controlplane
REDIS_URL=redis://host:6379
# 32+ random bytes, hex. Used to sign session cookies.
SESSION_SECRET=
# 32 random bytes, base64. AES-256-GCM key for tenant_secrets.
SECRETS_ENCRYPTION_KEY=

# --- Tenant platform ---
# HUMAN: confirm the domain we own for customer stores.
STORE_BASE_DOMAIN=example.store
BACKEND_IMAGE=ghcr.io/flowcheq/backend
STOREFRONT_IMAGE=ghcr.io/flowcheq/storefront
# Role with CREATE ROLE / CREATE DATABASE privileges (never used by tenants).
TENANT_PG_ADMIN_URL=postgres://admin:pass@host:5432/postgres
TENANT_PG_HOST=host
TENANT_PG_PORT=5432
TENANT_REDIS_URL=redis://host:6379

# --- Coolify ---
COOLIFY_URL=https://coolify.example.com
COOLIFY_TOKEN=
COOLIFY_PROJECT_UUID=
COOLIFY_SERVER_UUID=
COOLIFY_ENVIRONMENT_NAME=production

# --- Payments ---
# Use real values in production. These local placeholders keep the app bootable
# in development when a gateway is not yet configured.
PAYSTACK_PUBLIC_KEY=pk_test_local_placeholder
PAYSTACK_SECRET_KEY=sk_test_local_placeholder
PAYSTACK_WEBHOOK_SECRET=whsec_local_placeholder
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST_local_placeholder
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_local_placeholder
FLUTTERWAVE_WEBHOOK_SECRET=flutterwave_local_placeholder
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- DNS / domains ---
# cloudflare | hostinger | manual
DNS_PROVIDER=cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
HOSTINGER_API_TOKEN=
# The IP the wildcard record points to.
SERVER_PUBLIC_IP=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Flowcheq Commerce <no-reply@example.com>"

# --- Internal release webhook ---
# Shared secret for POST /api/internal/releases (used by the release workflow).
RELEASE_WEBHOOK_SECRET=

# --- Tenant backend container ---
# These are generated per tenant by the provisioner, never set globally.
# Postgres database created for this tenant.
DATABASE_URL=postgres://tenant:pass@host:5432/tenant
# Redis database/prefix reserved for this tenant (optional; Medusa falls back
# to an in-memory event bus and workflow engine when unset).
REDIS_URL=
# 32+ random bytes, hex. Signs admin/user JWTs for this tenant.
JWT_SECRET=
# 32+ random bytes, hex. Signs cookies for this tenant.
COOKIE_SECRET=
# Browser origins allowed to call this tenant's API, comma-separated.
STORE_CORS=https://tenant.example.store
ADMIN_CORS=https://tenant.example.store,https://api.tenant.example.store
AUTH_CORS=https://tenant.example.store,https://api.tenant.example.store
# Keep the connection pool small: many tenants share one Postgres server.
DB_POOL_MAX=5
# Set to true when the managed Postgres requires TLS.
DB_SSL=false
# JSON document validated by packages/tenant-config.
TENANT_CONFIG=
# Create demo products after bootstrapping (development only).
SEED_DEMO=false

# --- Tenant storefront container ---
# Base URL of this tenant's Medusa backend.
MEDUSA_BACKEND_URL=https://api.tenant.example.store
# Publishable API key titled "storefront" created by the bootstrap script.
MEDUSA_PUBLISHABLE_KEY=
# Business name shown in the storefront.
STORE_NAME=Tenant Store
# Brand colour applied as a CSS variable.
BRAND_PRIMARY_COLOR=#111111
# Optional absolute URL for the storefront logo.
BRAND_LOGO_URL=
# Country code used when the storefront has no country in the URL (ng, us, ...).
STORE_DEFAULT_REGION=ng
# Public storefront origin, used for canonical URLs and sitemap entries.
STORE_BASE_URL=https://tenant.example.store
# Publishable payment keys for this tenant (all optional; checkout hides the
# provider when its key is absent).
STRIPE_PUBLISHABLE_KEY=
MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
ADYEN_CLIENT_KEY=
ADYEN_ENVIRONMENT=test
