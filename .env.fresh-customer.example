# Fresh customer deployment template.
# Copy this file for EACH new customer: `cp .env.fresh-customer.example .env.<slug>`
# Fill in every HUMAN-marked value, then hand it to the provisioner.
# Never commit a filled copy: it holds real secrets.
#
# How one customer gets deployed on demand:
# 1. Customer pays -> order row appears in the control-plane database.
# 2. Staff mark the order paid in the dashboard -> provisioning job queued.
# 3. The provisioner reads this file's values (TENANT_CONFIG + secrets) and
#    creates the tenant backend + storefront on Coolify.
# 4. The tenant bootstrap creates the owner invite -> owner gets the
#    invite email -> store opens brand-new for them (see docs/customer-handoff.md).

# --- Who this customer is (HUMAN: fill in for every customer) ---
# URL-safe slug, lowercase letters/numbers/hyphens. Used for subdomains and DB names.
TENANT_SLUG=acme-skincare
# Display name shown in the admin and the default storefront.
TENANT_BUSINESS_NAME=Acme Skincare
# The store owner. They receive the invite email and set their own password.
TENANT_OWNER_EMAIL=owner@example.com
# starter | growth | scale (see packages/tenant-config).
TENANT_PLAN=starter
# ISO currency for the plan + store (NGN, USD, ...).
TENANT_CURRENCY=NGN
# Region hint for the sales channel (ng, us, eu, ...).
TENANT_REGION=ng

# --- Per-tenant JSON (HUMAN: generated from the values above) ---
# The provisioner validates this with @flowcheq/tenant-config (zod, strict).
# Example:
# TENANT_CONFIG={"slug":"acme-skincare","businessName":"Acme Skincare","ownerEmail":"owner@example.com","plan":"starter","currency":"NGN","region":"ng"}
TENANT_CONFIG=

# --- Per-tenant secrets (HUMAN: generate fresh for every customer) ---
# 32+ random bytes, hex. Signs this tenant's admin/user JWTs.
# Generate: `openssl rand -hex 32`
TENANT_JWT_SECRET=
# 32+ random bytes, hex. Signs this tenant's cookies. Different value from JWT.
TENANT_COOKIE_SECRET=
# Secret for the gateway -> tenant webhook (provisioner generates, gateway verifies).
TENANT_GATEWAY_WEBHOOK_SECRET=

# --- Email for this tenant's store (Brevo) ---
# Leave BREVO_API_KEY empty to boot without email; the admin shows a setup
# notice and invite/reset links land in the backend logs instead of inboxes.
# For a real customer handoff this must be set, otherwise the owner never
# receives their invite or password-reset emails.
# BREVO_FROM_EMAIL must be a verified sender in Brevo.
TENANT_BREVO_API_KEY=
TENANT_BREVO_FROM_EMAIL=no-reply@example.com
TENANT_BREVO_FROM_NAME=Flowcheq Commerce

# --- Public addresses (HUMAN: confirm per environment) ---
# Where the tenant backend serves the admin (/app) and where its storefront lives.
TENANT_ADMIN_URL=https://acme-skincare-admin.example.store/app
TENANT_STORE_URL=https://acme-skincare.example.store
# Public origin of the tenant admin, used to build invite/reset links.
MEDUSA_ADMIN_BACKEND_URL=https://acme-skincare-admin.example.store
# Public storefront origin, used in campaign email links.
TENANT_STOREFRONT_URL=https://acme-skincare.example.store

# --- Demo data (development only, never true for a real customer) ---
TENANT_SEED_DEMO=false
