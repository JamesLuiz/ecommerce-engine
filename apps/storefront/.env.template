# Tenant storefront.
# In production the provisioner injects these into each Coolify application.
# Values are read at runtime, never baked at build time, so one image serves
# every tenant. Copy this file to .env.local for local development.

# --- Required ---
# Base URL of this tenant's Medusa backend. Also accepts
# NEXT_PUBLIC_MEDUSA_BACKEND_URL as a fallback.
MEDUSA_BACKEND_URL=http://localhost:9000
# Publishable key titled "storefront", created by the tenant bootstrap. Also
# accepts NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY as a fallback.
MEDUSA_PUBLISHABLE_KEY=

# --- Branding ---
# Business name shown in the storefront.
STORE_NAME=Flowcheq Store
# Brand colour applied as a CSS variable.
BRAND_PRIMARY_COLOR=#111111
# Optional absolute URL for the storefront logo.
BRAND_LOGO_URL=
# Country code used when the URL has no country (ng, us, eu, ...).
STORE_DEFAULT_REGION=ng
# Public storefront origin, used for canonical URLs and sitemap entries.
STORE_BASE_URL=http://localhost:8000

# --- Optional payment provider publishable keys ---
# Checkout hides a provider when its key is absent.
STRIPE_PUBLISHABLE_KEY=
MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
ADYEN_CLIENT_KEY=
ADYEN_ENVIRONMENT=test
