# Tenant Medusa backend.
# In production the provisioner injects these into each Coolify application.
# Copy this file for local development.

# --- Core ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa-backend
# 32+ random bytes, hex. Signs admin/user JWTs for this tenant.
JWT_SECRET=supersecret
# 32+ random bytes, hex. Signs cookies for this tenant.
COOKIE_SECRET=supersecret
# Browser origins allowed to call this tenant's API, comma-separated.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000
# Keep the connection pool small: many tenants share one Postgres server.
DB_POOL_MAX=5
# Set to true when the managed Postgres requires TLS.
DB_SSL=false

# --- Flowcheq payments gateway ---
# Per-tenant values generated by the provisioner. Never the Paystack secret.
GATEWAY_URL=
GATEWAY_TOKEN=
GATEWAY_WEBHOOK_SECRET=

# --- Tenant bootstrap ---
# JSON document validated by packages/tenant-config (slug, businessName, plan,
# ownerEmail, currency, region).
TENANT_CONFIG=
# Create demo products after bootstrapping (development only).
SEED_DEMO=false
# Public storefront origin used in campaign email links.
STOREFRONT_URL=http://localhost:8000

# --- Email (Brevo, optional) ---
# Leave BREVO_API_KEY empty to boot without an email provider. Set the key and
# a verified sender to enable campaigns from Admin > Messages.
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@example.com
BREVO_FROM_NAME=Flowcheq Commerce
