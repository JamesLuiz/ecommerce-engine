# Runtime
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Postgres + Redis. docker compose overrides these with the pg/redis service hosts.
DATABASE_URL=postgres://gateway:gateway_dev_password@localhost:5432/gateway
REDIS_URL=redis://localhost:6379/0

# Paystack master account. Never copy this into a vendor Medusa instance.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co

# Control plane (staff dashboard). On a successful plan payment the gateway
# marks the order paid and queues provisioning. Optional: without these, tenant
# checkout payments still work but never trigger a deployment.
DASHBOARD_URL=https://dashboard.example.com
ORDER_WEBHOOK_SECRET=

# Provisioner credential for /admin/* routes. Generated for local development;
# regenerate with `openssl rand -hex 32` before any real deployment.
ADMIN_TOKEN=163d58c3cdd1190ba3513694891fe5ca

# Root key used to derive each vendor's webhook signing secret.
# Rotating it invalidates every vendor's verification of forwarded webhooks.
# Generated for local development; regenerate with `openssl rand -hex 32` in production.
WEBHOOK_SIGNING_ROOT=15a9a478822c276b6e086ce78129ddb3

# Feature flags
REFUNDS_ENABLED=false
SETTLEMENT_CHANGE_COOLDOWN_HOURS=0

# docker compose only: password for the bundled pg service.
PG_PASSWORD=gateway_dev_password
